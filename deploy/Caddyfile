{
	admin off
	persist_config off
	email {$JHONEME_ACME_EMAIL:admin@localhost}
	http_port 8080
	https_port 8443
}

# Container-only health endpoint; this port is never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}

{$JHONEME_SITE_ADDRESS:http://:8080} {
	root * /srv
	encode zstd gzip
	basic_auth {
		{$JHONEME_ADMIN_USER} {$JHONEME_PASSWORD_HASH}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
	@application path / /index.html /*.js /*.css
	header @application Cache-Control "no-store"
	file_server
}
