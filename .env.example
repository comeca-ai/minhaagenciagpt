# Referência. install.sh cria o .env real, sem senha em texto puro.
COMPOSE_PROJECT_NAME='jhoneme'
JHONEME_MODE='local'
JHONEME_SITE_ADDRESS='http://:8080'
JHONEME_ACME_EMAIL='admin@localhost'
JHONEME_LOCAL_PORT='8080'
JHONEME_ADMIN_USER='diretor'
# O hash bcrypt deve ficar entre aspas simples para preservar os caracteres $.
JHONEME_PASSWORD_HASH='GERADO_PELO_INSTALADOR'
CADDY_IMAGE='caddy:2-alpine'
# Opcional. Defina somente no .env privado ou com manage.sh deepgram.
DEEPGRAM_API_KEY=''
# Somente no servidor. O piloto de US$ 1 está no site; uma VPS não ganha outro lote automaticamente.
OPENAI_API_KEY=''
JHONEME_AI_LIMIT_MICROS='0'
JHONEME_AI_INITIAL_MICROS='0'
JHONEME_AI_INITIAL_RUNS='0'
